@startuml 
title "HealthcareService resource with its surrounding context R4"
skinparam classAttributeIconSize 0
skinparam roundcorner 5

class "Encounter" as Enc <<ENCOUNTER>> {
    An interaction between a patient and healthcare provider(s)
    for the purpose of providing healthcare service(s)
    or assessing the health status of a patient.
    ---
    serviceType : CodeableConcept (ServiceType / SEBaseHSAVerksamhetVS (required))
    serviceProvider: Reference (Organization)
    location.location: Reference (Location)
}


class "SEBaseOrganization" as Org <<ORGANIZATION>> {
    A formally or informally recognized grouping of people
    or organizations formed for the purpose of achieving 
    some form of collective action.
    ---
    identifer[hsaid]: Identifier 
    identifier[organizationIdentifer]: Identifier
    identifier[coordinationNumber]: Identifier
    identifier[personalIdentityNumber]: Identifier
    type: CodeableConcept (SEBaseOrganizationTypeVS (required)) 
    partOf : Reference (Organization)
    extension[organizationActive]: boolean
    extension[period]: period
    extension[additionalRelationship] : Complex
}

class "SEBaseHealthcareService" as HSvc <<HEALTHCARE_SERVICE>> {
    A single healthcare service or category of services
    that are provided by an organization at a location
    ---
    type: CodeableConcept (ServiceType / SEBaseHealthcareServicesVS (extensible))
    location: Reference (Location)
    providedBy: Reference (Organization)
    category: CodeableConcept (BusinessCategory / SEBaseHSAVerksamhetVS (extensible))
    characteristic: CodeableConcept (EncounterMeans / SEBaseEncounterMeansVS (example))
    extension[period] : Period
}

class "Location" as Loc <<LOCATION>> {
    A physical place where services are provided 
    and resources and participants may be stored, 
    found, contained, or accommodated.
    ---
    type: CodeableConcept (Functionality / SEBaseLocationFunctionVS (example))
    partOf : Reference (Location)
    extension[positionSweref] : Complex
    extension[period] : Period
}






Enc --> "0..1" Org : "serviceProvider.Reference"
HSvc --> "0..1" OrgUnit : "providedBy.Reference"
Org --> "0..1" Org : "partOf.Reference"
HSvc --> "0..*" Loc : "location.Reference"
Enc --> "0..1" Loc : "location.location.Reference"
Loc --> "0..1" Org : "managingOrganization.Reference"
Loc --> "0..1" Loc : "partOf.Reference"
Bus --> "1..1" OrgUnit : "providedBy.Reference"
OrgUnit --> "0..1" OrgUnit : "partOf.Reference"
OrgUnit --> "0..1" Org : "partOf.Reference"
Bus --> "0..*" Loc : "location.Reference"

